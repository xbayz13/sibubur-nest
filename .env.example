# Application Configuration
NODE_ENV=development
PORT=3030

# Database Configuration
# Option 1: PostgreSQL connection string (recommended for production)
# DATABASE_URL=postgresql://username:password@localhost:5432/sibubur

# Option 2: Individual PostgreSQL variables
DB_TYPE=postgres
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=your_password
DB_NAME=sibubur

# Option 3: SQLite (development only)
# DB_TYPE=sqlite
# DB_PATH=sibubur.db

# JWT Configuration
JWT_SECRET=your-secret-key-minimum-32-characters-long
JWT_EXPIRES_IN=24h

# Rate Limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# Cache (reports TTL in milliseconds, default: 120000 = 2 minutes)
CACHE_TTL_REPORT=120000

# Logging: in production, request log only when LOG_LEVEL=debug or sampled
LOG_LEVEL=info
LOG_SAMPLE_RATE=0.01

# CORS Configuration (comma-separated origins; * = allow all)
# In production, CORS_ORIGIN is required — set to your frontend origin(s), e.g. https://app.example.com
CORS_ORIGIN=*
